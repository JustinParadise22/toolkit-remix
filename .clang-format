AccessModifierOffset: -4
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: true
AlignConsecutiveDeclarations: true
AlignEscapedNewlinesLeft: true
AlignTrailingComments: true
AllowAllParametersOfDeclarationOnNextLine: true
AllowShortFunctionsOnASingleLine: true
AllowShortIfStatementsOnASingleLine: true
AllowShortCaseLabelsOnASingleLine : true
AllowShortLoopsOnASingleLine: true
AlwaysBreakAfterDefinitionReturnType: true
AlwaysBreakBeforeMultilineStrings: true
AlwaysBreakTemplateDeclarations: true
BinPackArguments: true
BinPackParameters: true
BreakBeforeBinaryOperators: true
BreakBeforeBraces: Allman
BreakBeforeTernaryOperators: true
BreakConstructorInitializersBeforeComma: true
BreakStringLiterals: true
ColumnLimit: 12000
CommentPragmas: ''
ConstructorInitializerAllOnOneLineOrOnePerLine: true
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 4
Cpp11BracedListStyle: true
DerivePointerBinding: true
FixNamespaceComments: true
IndentCaseLabels: true
IndentPPDirectives: AfterHash
IndentFunctionDeclarationAfterType: true
IndentWidth: 5
SortIncludes: true
IncludeCategories:
  - Regex:           '<carb\/.+>'
    Priority:        2
  - Regex:           '<[[:alnum:]_.]+>'
    Priority:        4
  - Regex:           '<[[:alnum:]_.\/]+>'
    Priority:        3
  - Regex:           '".*"'
    Priority:        1
IncludeBlocks: Regroup
Language: Cpp
MaxEmptyLinesToKeep: 2
NamespaceIndentation: None
ObjCSpaceAfterProperty: true
ObjCSpaceBeforeProtocolList: true
PenaltyBreakBeforeFirstCallParameter: 0
PenaltyBreakComment: 1
PenaltyBreakFirstLessLess: 0
PenaltyBreakString: 1
PenaltyExcessCharacter: 10
PointerAlignment: Left
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: true
SpacesBeforeTrailingComments: 1
SpacesInAngles: true
SpacesInCStyleCastParentheses: true
SpacesInContainerLiterals: true
SpacesInParentheses: true
Standard: Cpp11
TabWidth: 4
UseTab: Never

WhitespaceSensitiveMacros: []

DeriveLineEnding: true

SortUsingDeclarations: true

SortUsingDeclarationsCaseSensitive: true
UseCRLF: true
UseLF: true
UseCR: true
LineEnding: Auto
InsertFinalNewline: true
TrimTrailingWhitespace: true
KeepEmptyLinesAtTheStartOfBlocks: true
SpaceAfterTemplateKeyword: true
SpaceBeforeCpp11BracedList: true
SpaceAfterCStyleCast: true
SpaceAroundPointerQualifiers: Default
SpaceBeforeRangeBasedForLoopColon: true
SpaceAfterRangeBasedForLoopColon: true
BreakBeforeInheritanceComma: true
BreakAfterJavaFieldAnnotations: true
BreakAfterJavaPackage: true
BreakBeforeJavaFieldAnnotations: true
JavaScriptQuotes: Double
JavaScriptWrapImports: true
MaxMethodChainLength: 3
ObjCBlockIndentWidth: 4
ObjCSelfAccess: UseDot
PenaltyIndentWidth: 4
PenaltyReturnTypeOnItsOwnLine: 2000
SpacesInSquareBrackets: true
SpaceBeforeSquareBrackets: true
SpaceAfterSquareBrackets: true
SpaceBeforeObjCMethodCallSelectorColon: true
SpaceAfterObjCMethodCallSelectorColon: true
SpaceBeforeObjCMethodDeclSelectorColon: true
SpaceAfterObjCMethodDeclSelectorColon: true
ObjCMethodDeclIndentWidth: 4
ObjCMethodCallIndentWidth: 4
AlignObjCMethodParams: true
ObjCSpaceBeforePropertyColon: true
ObjCSpaceAfterPropertyColon: true
ObjCSpaceBeforeMethodCallSelectorColon: true
ObjCSpaceAfterMethodCallSelectorColon: true
ObjCSpaceBeforeMethodDeclSelectorColon: true
ObjCSpaceAfterMethodDeclSelectorColon: true
PenaltyObjCMethodDeclParameterList: 150
PenaltyObjCMethodCallParameterList: 150
SpacesInObjCMethodDeclParentheses: true
SpacesInObjCMethodCallParentheses: true
SpaceAfterObjCDeclarationType: true
SpaceBeforeObjCProtocolList: true
SpaceAfterObjCProtocolList: true
ObjCAlignProtocolList: true
ObjCIndentProtocolList: AfterInterface

